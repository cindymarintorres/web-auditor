{
  "name": "web-auditor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "save-session": "tsx scripts/save-session.ts",
    "download-series": "tsx scripts/download-series.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "playwright": "1.49.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}